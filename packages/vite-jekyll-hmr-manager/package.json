{
  "name": "@leuffen/vite-jekyll-hmr-manager",
  "version": "1.0.3",
  "description": "Vite integration for page-aware reloads of Jekyll build output with HMR notifications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leuffen/leuffen-monorepo.git",
    "directory": "packages/vite-jekyll-hmr-manager"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "scripts": {
    "build": "nx build @leuffen/vite-jekyll-hmr-manager"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.js",
    "*.cjs",
    "*.d.ts",
    "*.d.ts.map",
    "src/**/*.d.ts",
    "src/**/*.d.ts.map",
    "README.md",
    "package.json"
  ],
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
