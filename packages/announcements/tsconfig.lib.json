{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "rootDir": ".",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
  },
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "test/**/*.ts",
    "vite.config.ts"
  ],
  "include": ["index.ts", "src/**/*.ts", "src/**/*.d.ts"]
}
