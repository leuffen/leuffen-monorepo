{
  "name": "@leuffen/demo",
  "version": "0.0.0",
  "description": "Reference package for the Leuffen Nx monorepo.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
