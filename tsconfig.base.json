{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "declaration": false,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "paths": {
      "@leuffen/announcements": ["packages/announcements/index.ts"],
      "@leuffen/demo": ["packages/demo/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "tmp"]
}
